    {
      "index": 7,
      "title": "Applications",
      "size": [
        13.333,
        7.5
      ],
      "blocks": [
        {
          "type": "title",
          "text": "Applications",
          "level": 0,
          "bbox": [
            0.6,
            0.45,
            12.1,
            1.05
          ]
        },
        {
          "type": "bullet",
          "text": "Symbol tables in compilers and interpreters.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "Set membership, plus Bloom filters when an approximate answer is enough.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "Caches combine hashing with an eviction policy such as LRU.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        }
      ],
      "flags": {
        "text_layer": true
      }
    },
    {
      "index": 8,
      "title": "Common Mistakes",
      "size": [
        13.333,
        7.5
      ],
      "blocks": [
        {
          "type": "title",
          "text": "Common Mistakes",
          "level": 0,
          "bbox": [
            0.6,
            0.45,
            12.1,
            1.05
          ]
        },
        {
          "type": "bullet",
          "text": "Using a mutable object as a key breaks the invariant once it is mutated.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "Assuming O(1) worst case: adversarial keys can force Θ(n) per operation.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "Forgetting that iteration order is arbitrary, which makes output unstable between runs.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        }
      ],
      "flags": {
        "text_layer": true
      }
    },
    {
      "index": 9,
      "title": "Choosing a Strategy",
      "size": [
        13.333,
        7.5
      ],
      "blocks": [
        {
          "type": "title",
          "text": "Choosing a Strategy",
          "level": 0,
          "bbox": [
            0.6,
            0.45,
            12.1,
            1.05
          ]
        },
        {
          "type": "bullet",
          "text": "Chaining is simpler to delete from and tolerates high load factors.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "Open addressing is faster when the table fits in cache and keys are small.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "Untrusted input requires a keyed hash such as SipHash, not a plain polynomial hash.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        }
      ],
      "flags": {
        "text_layer": true
      }
    },
    {
      "index": 10,
      "title": "Summary",
      "size": [
        13.333,
        7.5
      ],
      "blocks": [
        {
          "type": "title",
          "text": "Summary",
          "level": 0,
          "bbox": [
            0.6,
            0.45,
            12.1,
            1.05
          ]
        },
        {
          "type": "bullet",
          "text": "Hashing turns a search problem into an indexing problem.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "Collision handling and load factor decide the real constant factors.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "The worst case stays linear, so untrusted input needs keyed hashing.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        }
      ],
      "flags": {
        "text_layer": true
      }
    }

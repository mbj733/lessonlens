      ],
      "blocks": [
        {
          "type": "title",
          "text": "Summary",
          "level": 0,
          "bbox": [
            57.024,
            54.308,
            73.5,
            21.0
          ]
        },
        {
          "type": "bullet",
          "text": "Comparison sorts cannot beat Ω(n log n) in the worst case.",
          "level": 0,
          "bbox": [
            59.024,
            94.112,
            382.75,
            13.373
          ]
        },
        {
          "type": "bullet",
          "text": "Merge sort trades memory for stability and predictable time.",
          "level": 0,
          "bbox": [
            59.024,
            121.112,
            389.0,
            13.373
          ]
        },
        {
          "type": "bullet",
          "text": "Quick sort is usually fastest but must guard against bad pivots.",
          "level": 0,
          "bbox": [
            59.024,
            148.112,
            414.0,
            13.373
          ]
        }
      ],

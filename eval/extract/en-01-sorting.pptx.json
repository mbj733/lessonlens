    {
      "index": 8,
      "title": "Linear-Time Sorts",
      "size": [
        13.333,
        7.5
      ],
      "blocks": [
        {
          "type": "title",
          "text": "Linear-Time Sorts",
          "level": 0,
          "bbox": [
            0.6,
            0.45,
            12.1,
            1.05
          ]
        },
        {
          "type": "bullet",
          "text": "Counting sort runs in Θ(n + k) when keys are integers in [0, k).",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "Radix sort sorts digit by digit from the least significant position.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "Both are non-comparison sorts, so the Ω(n log n) bound does not apply.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        }
      ],
      "flags": {
        "text_layer": true
      }
    },
    {
      "index": 9,
      "title": "Choosing a Sort",
      "size": [
        13.333,
        7.5
      ],
      "blocks": [
        {
          "type": "title",
          "text": "Choosing a Sort",
          "level": 0,
          "bbox": [
            0.6,
            0.45,
            12.1,
            1.05
          ]
        },
        {
          "type": "bullet",
          "text": "Nearly sorted input: insertion sort is close to Θ(n).",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "External sorting on disk: merge sort minimises sequential I/O.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "Hard real-time guarantees: heap sort avoids the quadratic worst case.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        }
      ],
      "flags": {
        "text_layer": true
      }
    },
    {
      "index": 10,
      "title": "Summary",
      "size": [
        13.333,
        7.5
      ],
      "blocks": [
        {
          "type": "title",
          "text": "Summary",
          "level": 0,
          "bbox": [
            0.6,
            0.45,
            12.1,
            1.05
          ]
        },
        {
          "type": "bullet",
          "text": "Comparison sorts cannot beat Ω(n log n) in the worst case.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "Merge sort trades memory for stability and predictable time.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "Quick sort is usually fastest but must guard against bad pivots.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        }
      ],

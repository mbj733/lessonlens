    {
      "index": 9,
      "title": "Why Not a Sorted Array",
      "size": [
        13.333,
        7.5
      ],
      "blocks": [
        {
          "type": "title",
          "text": "Why Not a Sorted Array",
          "level": 0,
          "bbox": [
            0.6,
            0.45,
            12.1,
            1.05
          ]
        },
        {
          "type": "bullet",
          "text": "A sorted array searches in O(log n) but inserts in O(n) because of shifting.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "A BST keeps both operations logarithmic when it stays balanced.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "Cache locality still favours arrays for read-only workloads.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        }
      ],
      "flags": {
        "text_layer": true
      }
    },
    {
      "index": 10,
      "title": "Summary",
      "size": [
        13.333,
        7.5
      ],
      "blocks": [
        {
          "type": "title",
          "text": "Summary",
          "level": 0,
          "bbox": [
            0.6,
            0.45,
            12.1,
            1.05
          ]
        },
        {
          "type": "bullet",
          "text": "The BST invariant turns search into a guided path.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "Height is the only performance variable: balance it or pay Θ(n).",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        },
        {
          "type": "bullet",
          "text": "In-order traversal is why BSTs support ordered iteration.",
          "level": 0,
          "bbox": [
            0.85,
            1.85,
            11.6,
            5.0
          ]
        }
      ],
      "flags": {

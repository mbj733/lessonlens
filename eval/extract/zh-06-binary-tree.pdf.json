          ]
        },
        {
          "type": "body",
          "text": "先序 栈或递归 O(n) O(h)",
          "level": 0,
          "bbox": [
            56.024,
            123.831,
            390.921,
            10.5
          ]
        },
        {
          "type": "body",
          "text": "中序 栈或递归 O(n) O(h)",
          "level": 0,
          "bbox": [
            56.024,
            145.831,

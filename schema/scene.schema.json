{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mbj733.github.io/lessonlens/schema/scene.schema.json",
  "title": "LessonLens scene",
  "description": "The single intermediate truth: renderer, USDZ exporter and evaluator all read this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "deck", "objects", "interactions", "tasks", "meta"],
  "properties": {
    "schema": { "const": "lessonlens/scene@1" },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "lang", "pages", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "lang": { "enum": ["en", "zh"] },
        "pages": { "type": "integer", "minimum": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 8,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "primitive", "position", "scale", "color", "page", "kind", "claims"],
        "properties": {
          "id": { "type": "string", "pattern": "^o[0-9]{2}$" },
          "label": { "type": "string", "minLength": 2, "maxLength": 80 },
          "primitive": { "enum": ["box", "sphere", "cylinder", "cone", "plane"] },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number", "minimum": -50, "maximum": 50 }
          },
          "scale": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 }
          },
          "rotation": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" }
          },
          "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
          "page": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["concept", "definition", "example", "summary"] },
          "claims": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "quote", "page"],
              "properties": {
                "text": { "type": "string", "minLength": 8, "maxLength": 300 },
                "quote": { "type": "string", "minLength": 12, "maxLength": 300 },
                "page": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "interactions": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "target", "reveal"],
        "properties": {
          "id": { "type": "string", "pattern": "^i[0-9]{2}$" },
          "type": { "enum": ["click", "hover"] },
          "target": { "type": "string", "pattern": "^o[0-9]{2}$" },
          "reveal": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "body"],
            "properties": {
              "title": { "type": "string", "minLength": 2, "maxLength": 120 },
              "body": { "type": "string", "minLength": 12, "maxLength": 600 }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "prompt", "answers", "explanation"],
        "properties": {
          "id": { "type": "string", "pattern": "^t[0-9]{2}$" },
          "kind": { "enum": ["identify", "order"] },
          "prompt": { "type": "string", "minLength": 8, "maxLength": 300 },
          "answers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "type": "string", "pattern": "^o[0-9]{2}$" }
          },
          "explanation": { "type": "string", "minLength": 8, "maxLength": 400 }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "object_count", "triangle_estimate"],
      "properties": {
        "generator": { "enum": ["mock", "deepseek", "cache"] },
        "object_count": { "type": "integer", "minimum": 8, "maximum": 24 },
        "triangle_estimate": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "notes": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
